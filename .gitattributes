* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.cmd text eol=crlf
*.rgba binary
*.bin binary
*.png binary
*.zip binary

# Preserve the pinned native admission/provider source bytes.
src/owner_admission/** text eol=lf

# Preserve exact upstream notice hashes and patch context.
runtime-patches/cs2/upstream-notices/** -text
runtime-patches/blender/upstream-notices/** -text
runtime-patches/blender/*.patch -text
