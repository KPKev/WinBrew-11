diff --git a/native/return_intent.c b/native/return_intent.c
new file mode 100644
index 0000000..67f0b3d
--- /dev/null
+++ b/native/return_intent.c
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "return_intent.h"
+#include <stddef.h>
+#include <string.h>
+
+static int bounded_length(const char *text, size_t limit, size_t *length)
+{
+    if (!text) return 0;
+    for (size_t n = 0; n <= limit; ++n) {
+        if (!text[n]) { *length = n; return 1; }
+    }
+    return 0;
+}
+static int session_argument(const char *text, size_t length)
+{
+    if (length != 44 || memcmp(text, "session=", 8)) return 0;
+    const char *id = text + 8;
+    for (size_t n = 0; n < 36; ++n) {
+        const int dash = n == 8 || n == 13 || n == 18 || n == 23;
+        const char c = id[n];
+        if (dash ? c != '-' : !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')))
+            return 0;
+    }
+    return 1;
+}
+int wine11_return_parse(int argc, const char *const *argv, Wine11ReturnIntent *out)
+{
+    Wine11ReturnIntent candidate = {0};
+    /* Existing Playden title-launch boundary permits no more than eight args. */
+    if (!out || argc < 0 || argc > 8 || (argc && !argv)) return -1;
+    for (int n = 0; n < argc; ++n) {
+        size_t length;
+        if (!argv[n] || !argv[n][0]) continue;
+        if (!bounded_length(argv[n], 64, &length)) return -1;
+        if (length == sizeof(WINE11_RETURN_ARGUMENT) - 1 &&
+            !memcmp(argv[n], WINE11_RETURN_ARGUMENT, length)) {
+            if (candidate.requested) return -1;
+            candidate.requested = 1;
+        } else if (session_argument(argv[n], length)) {
+            if (candidate.session_argument) return -1;
+            candidate.session_argument = argv[n];
+        } else return -1;
+    }
+    *out = candidate;
+    return 0;
+}
+Wine11ReturnExit wine11_return_finish(Wine11ReturnIntent *intent, int was_running,
+                                     const Wine11ReturnExitOps *ops)
+{
+    if (!intent || intent->consumed || !ops || !ops->finish_session ||
+        !ops->close_session || !ops->close_publication) return WINE11_RETURN_HOME;
+    intent->consumed = 1; /* One attempt per native game process; no restart loop. */
+    const int reported = ops->finish_session(ops->context, was_running != 0);
+    ops->close_session(ops->context);
+    ops->close_publication(ops->context);
+    if (!intent->requested || !was_running || reported != 0 || !ops->launch_title)
+        return WINE11_RETURN_HOME;
+    const uint32_t result = ops->launch_title(ops->context, WINE11_RETURN_TITLE);
+    return result & 0x80000000u ? WINE11_RETURN_HOME : WINE11_RETURN_WAIT_FOR_HANDOFF;
+}
diff --git a/native/return_intent.h b/native/return_intent.h
new file mode 100644
index 0000000..26ad7cb
--- /dev/null
+++ b/native/return_intent.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Design prototype only: not part of Wine 11 or the installed game wrapper. */
+#ifndef WINE11_RETURN_INTENT_H
+#define WINE11_RETURN_INTENT_H
+#include <stdint.h>
+
+#define WINE11_RETURN_TITLE "PPSA77381"
+#define WINE11_RETURN_ARGUMENT "wine11-return=" WINE11_RETURN_TITLE
+#define WINE11_RETURN_FEATURE "wine11-return-on-exit-v1"
+
+typedef struct Wine11ReturnIntent {
+    const char *session_argument;
+    int requested;
+    int consumed;
+} Wine11ReturnIntent;
+
+/* Accept legacy session=<canonical UUID> and one fixed opt-in return argument.
+ * Empty/NULL argv slots keep the original wrapper's behavior. Output is changed
+ * only on success. No arbitrary destination, file, command or URL is accepted. */
+int wine11_return_parse(int argc, const char *const *argv, Wine11ReturnIntent *out);
+
+typedef struct Wine11ReturnExitOps {
+    void *context;
+    /* Return zero after reporting the existing session's exited/failed phase. */
+    int (*finish_session)(void *, int was_running);
+    void (*close_session)(void *);
+    void (*close_publication)(void *);
+    /* Must use the existing PS5 title-launch ABI and current foreground user.
+     * This callback is passed only the fixed Wine 11 target. */
+    uint32_t (*launch_title)(void *, const char *title);
+} Wine11ReturnExitOps;
+
+typedef enum Wine11ReturnExit {
+    WINE11_RETURN_HOME = 0,
+    WINE11_RETURN_WAIT_FOR_HANDOFF = 1
+} Wine11ReturnExit;
+
+/* Called only from normal per-game Wine exit, after Wine is done. The actual
+ * wrapper remains responsible for diagnostics closure and the final platform
+ * action: wait for an accepted handoff, otherwise existing leave_to_home().
+ * A crash/PS5 Close Game never calls this normal-exit helper. */
+Wine11ReturnExit wine11_return_finish(Wine11ReturnIntent *intent, int was_running,
+                                     const Wine11ReturnExitOps *ops);
+#endif
diff --git a/native/return_native.c b/native/return_native.c
new file mode 100644
index 0000000..c72c9c4
--- /dev/null
+++ b/native/return_native.c
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "return_native.h"
+#include "return_intent.h"
+#include <stddef.h>
+#include <string.h>
+/* Same platform ABI used by Wine 11 and Playden's native title backend. */
+struct Wine11LaunchParameters {
+    uint32_t size, user, options;
+    uint64_t crash_report;
+    uint32_t check_flag;
+};
+_Static_assert(sizeof(struct Wine11LaunchParameters) == 32, "native launch ABI size");
+_Static_assert(offsetof(struct Wine11LaunchParameters, check_flag) == 24, "native launch ABI offset");
+int sceSysmoduleLoadModuleInternal(uint32_t);
+int sceUserServiceInitialize(const void *);
+int sceUserServiceGetForegroundUser(uint32_t *);
+uint32_t sceSystemServiceLaunchApp(const char *, const char **, void *);
+static int ready;
+uint32_t wine11_return_native_preload(void)
+{
+    uint32_t user = 0;
+    ready = 0;
+    /* The wrapper already imports SystemService for LoadExec. Duplicate module
+     * load / user initialization may report already-loaded; the user query is
+     * the usable-provider test. Runtime dlsym is deliberately avoided. */
+    (void)sceSysmoduleLoadModuleInternal(0x80000010u);
+    (void)sceUserServiceInitialize(NULL);
+    uint32_t result = (uint32_t)sceUserServiceGetForegroundUser(&user);
+    ready = result == 0;
+    return result;
+}
+uint32_t wine11_return_native_launch(void *unused, const char *title)
+{
+    uint32_t user = 0;
+    (void)unused;
+    if (!ready) return 0x80020026u; /* ENOSYS */
+    if (!title || strcmp(title, WINE11_RETURN_TITLE)) return 0x80020016u; /* EINVAL */
+    uint32_t result = (uint32_t)sceUserServiceGetForegroundUser(&user);
+    if (result) return result | 0x80000000u;
+    /* SkipLaunchCheck is the existing big-app handoff ABI after root grant.
+     * This function is reached only after running/publication/session admission. */
+    struct Wine11LaunchParameters parameters = {sizeof(parameters), user, 0, 0, 1};
+    return sceSystemServiceLaunchApp(WINE11_RETURN_TITLE, NULL, &parameters);
+}
