+/* Best effort only: fixed labels and numeric fields; never alter errno. */
+static int startup_checkpoint_sink(const char *label, int result, int helper_error)
+{
+    if (!ps5log_enabled()) return -1;
+    return ps5log_printf(PS5LOG_INFO, "PW_STARTUP checkpoint=%s result=%d helper_error=%d",
+                         label, result, helper_error);
+}
+static void startup_checkpoint(PwStartupCheckpoint event, int result, int helper_error)
+{
+    pw_startup_checkpoint_emit(startup_checkpoint_sink, event, result, helper_error);
+}
 
