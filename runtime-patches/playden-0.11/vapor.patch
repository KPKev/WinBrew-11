+// Some PS5 SDKs report access(W_OK) as unavailable even for writable folders.
+// Prove the operation we need with an exclusive, private temporary file.
+bool WritableFolder(const std::string& path) {
+  if (!IsFolder(path)) return false;
+  std::string probe = path + "/.vapor-update-write-XXXXXX";
+  const int fd = mkstemp(probe.data());
+  if (fd < 0) return false;
+  const bool closed = close(fd) == 0;
+  const bool removed = unlink(probe.c_str()) == 0;
+  return closed && removed;
+}
 
