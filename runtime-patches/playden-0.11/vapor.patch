--- /dev/null
+++ b/tests/vapor_test_cleanup.h
@@ -0,0 +1,21 @@
+#pragma once
+#include <filesystem>
+#if defined(__linux__)
+#include <ftw.h>
+#include <cstdio>
+#include <cerrno>
+#include <system_error>
+#endif
+namespace playden::test {
+inline void RemoveAll(const std::filesystem::path& path) {
+#if defined(__linux__)
+  // Linux libstdc++ remove_all uses openat, which these native-policy tests
+  // deliberately disable process-wide. nftw performs cleanup independently
+  // while all production calls still exercise the unavailable-at fallback.
+  if (::nftw(path.c_str(), [](const char* name, const struct stat*, int, struct FTW*) { return ::remove(name); }, 16, FTW_DEPTH|FTW_PHYS) && errno != ENOENT)
+    throw std::system_error(errno, std::generic_category(), "test fixture cleanup");
+#else
+  std::filesystem::remove_all(path);
+#endif
+}
+}
