--- a/dlls/win32u/ps5drv.c
+++ b/dlls/win32u/ps5drv.c
@@ -120,6 +120,9 @@
 static HWND vulkan_window;
 static RECT vulkan_client;
 static ULONG vulkan_tick;
+#ifdef SONAME_LIBVULKAN
+static int (*vulkan_cursor_show)( const UINT32 *, UINT, UINT, INT, INT, INT, INT, UINT, UINT );
+#endif
 static BOOL display_published;
 static DWORD input_threads[PS5_MAX_WINDOWS];
 static UINT input_thread_count;
@@ -224,6 +227,24 @@
 static void present_screen_for_change(void)
 {
     if (!vulkan_presenting()) present_screen();
+}
+
+/* screen_lock held: move the hardware cursor even when an event-driven
+ * Vulkan application does not present another frame. */
+static void present_pointer_change(void)
+{
+#ifdef SONAME_LIBVULKAN
+    if (vulkan_cursor_show && vulkan_window &&
+        vulkan_client.right > vulkan_client.left && vulkan_client.bottom > vulkan_client.top)
+    {
+        vulkan_cursor_show( cursor_width && cursor_height ? cursor_image : NULL, cursor_width, cursor_height,
+                            cursor_hotspot.x, cursor_hotspot.y,
+                            cursor.x - vulkan_client.left, cursor.y - vulkan_client.top,
+                            vulkan_client.right - vulkan_client.left, vulkan_client.bottom - vulkan_client.top );
+        return;
+    }
+#endif
+    present_screen_for_change();
 }
 
 /***********************************************************************
